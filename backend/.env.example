HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Email (Resend) — optionnel en local. Laisser vide : les envois échouent
# silencieusement (juste un warning en log), rien d'autre n'est affecté.
# Voir backend/.env.production.example pour la configuration de prod.
RESEND_API_KEY=
MAIL_FROM=INTERFORMCI <no-reply@interformci.com>
MAIL_REPLY_TO=cabinterformci@gmail.com
MAIL_TO=cabinterformci@gmail.com
