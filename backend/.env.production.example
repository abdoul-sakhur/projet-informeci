# Production secrets for the Strapi backend — copy to backend/.env.production
# and fill in real values. Never commit the filled-in file.
#
# Generate fresh secrets (do NOT reuse the ones from .env.example / local dev):
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# Run it 4 times for APP_KEYS (comma-separated) and once each for the rest.

HOST=0.0.0.0
PORT=1337
APP_KEYS=changeme1,changeme2,changeme3,changeme4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# Database — SQLite is fine for a small VPS as long as the .tmp volume
# (declared in docker-compose.prod.yml) is persisted and backed up. For
# higher-traffic deployments, switch to Postgres (DATABASE_CLIENT=postgres
# and the matching DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD).
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Must match the public API domain used in .env.prod (API_DOMAIN), so Strapi
# generates correct absolute URLs (media, admin panel links, etc.).
URL=https://api.example.com

# Email (Resend) — à activer au déploiement final, une fois le domaine réel
# branché. Étapes :
#   1. Créer un compte sur resend.com (gratuit, 3000 emails/mois)
#   2. Ajouter et vérifier le domaine interformci.com (enregistrements DNS
#      fournis par Resend — DKIM/SPF)
#   3. Générer une clé API et la coller ci-dessous
# Tant que RESEND_API_KEY est vide, les envois échouent silencieusement
# (warning en log uniquement) — le site fonctionne normalement sans emails.
RESEND_API_KEY=
MAIL_FROM=INTERFORMCI <no-reply@interformci.com>
MAIL_REPLY_TO=cabinterformci@gmail.com
MAIL_TO=cabinterformci@gmail.com
