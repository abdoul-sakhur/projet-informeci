# Production image for the Strapi backend.
# Multi-stage: compile TS + build the admin panel in `build`, then ship only the
# compiled output and production dependencies in `runtime` — no source, no
# devDependencies, no build tooling in the final image.

FROM node:20-bookworm-slim AS build
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json* ./
RUN npm install

COPY . .
# types/generated is derived from the content-type schemas and gitignored (it's
# regenerated continuously by `strapi develop` in local dev, which is why it's
# present on a dev machine but absent on a fresh clone) — `strapi build` type-checks
# against it, so it must be (re)generated here before compiling.
RUN npx strapi ts:generate-types && npm run build

# ---- runtime ----
FROM node:20-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN groupadd -r strapi && useradd -r -g strapi -m strapi

COPY package.json package-lock.json* ./
RUN npm install --omit=dev && npm cache clean --force

COPY --from=build /app/dist ./dist
COPY --from=build /app/public ./public
COPY --from=build /app/seed-assets ./seed-assets
COPY --from=build /app/favicon.png ./favicon.png
# `strapi start` checks for tsconfig.json in appDir to decide where the compiled
# output lives; without it, it assumes distDir = appDir and looks for config/src
# at the project root instead of ./dist, silently loading an empty config (the
# database connection then explodes with "Cannot destructure property 'client'
# of 'db.config.connection'"). Just the JSON file — no devDependencies needed.
COPY --from=build /app/tsconfig.json ./tsconfig.json

# .tmp (sqlite db) and public/uploads must be writable and, in real
# deployments, mounted as persistent volumes — see docker-compose.prod.yml.
RUN mkdir -p .tmp public/uploads && chown -R strapi:strapi /app

USER strapi
EXPOSE 1337
CMD ["npm", "run", "start"]
