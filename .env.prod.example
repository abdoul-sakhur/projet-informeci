# Copy to .env.prod and fill in your real values before deploying.
# Point both DNS A records at the VPS's IP before starting the stack,
# otherwise Traefik (now a dedicated service on this VPS — see
# docker-compose.prod.yml) will fail to obtain Let's Encrypt certificates.
#
# Two-domain setup: FRONTEND_DOMAIN (+ its www. subdomain) serves the Next.js
# site, API_DOMAIN serves Strapi. Verify propagation first:
#   dig +short interformci.com
#   dig +short www.interformci.com
#   dig +short api.interformci.com
# All three must resolve to the VPS's IP.

FRONTEND_DOMAIN=interformci.com
API_DOMAIN=api.interformci.com

# Used by Traefik to register with Let's Encrypt (renewal notices go here,
# never shown publicly).
ACME_EMAIL=cabinterformci@gmail.com
